{
  "name": "feibijiubi",
  "version": "1.7.0",
  "main": ".build/src/main/main.js",
  "description": "菲比啾比 - 鸣潮抽卡分析工具",
  "author": "feibijiubi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Untsia/FeibiJiubi.git"
  },
  "homepage": "https://github.com/Untsia/FeibiJiubi",
  "scripts": {
    "start": "node scripts/compile-main.js && electron .build/src/main/main.js",
    "test": "node scripts/compile-main.js && node --test \"tests/*.test.js\"",
    "dev:react": "vite --config src/renderer-react/vite.config.mts",
    "build:renderer": "node scripts/compile-main.js buildRenderer",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{js,ts,tsx,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,tsx,css,html}\"",
    "obfuscate": "node scripts/obfuscate.js",
    "prebuild": "node scripts/build-pipeline.js",
    "build": "node scripts/build.js --publish never",
    "release": "node scripts/build.js --publish always",
    "build:insecure": "node -e \"process.env.SKIP_HARDEN='1';require('child_process').execSync('npm run build',{stdio:'inherit'})\""
  },
  "keywords": [
    "wuthering-waves",
    "鸣潮",
    "抽卡分析",
    "唤取",
    "gacha",
    "electron"
  ],
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "asarmor": "^1.8.3",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.1",
    "globals": "^15.14.0",
    "javascript-obfuscator": "^5.6.0",
    "prettier": "^3.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "better-sqlite3": "^13.0.3",
    "dayjs": "^1.11.13",
    "iconv-lite": "^0.7.3"
  },
  "build": {
    "appId": "com.feibijiubi.app",
    "productName": "菲比啾比",
    "copyright": "Copyright © 2026",
    "releaseInfo": {
      "releaseNotesFile": "release-notes.md"
    },
    "files": [
      ".build/src/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "electronDist": "node_modules/electron/dist",
    "electronVersion": "44.0.0",
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "afterPack": "scripts/afterPack.js",
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "src/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "artifactName": "FeibiJiubi-${version}-windows-${arch}-setup.exe",
      "differentialPackage": false
    },
    "portable": {
      "artifactName": "FeibiJiubi-${version}-windows-${arch}-portable.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Untsia",
        "repo": "FeibiJiubi",
        "publishAutoUpdate": false
      }
    ]
  }
}

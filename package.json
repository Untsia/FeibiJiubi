{
  "name": "feibijiubi",
  "version": "1.6.0",
  "main": ".build/src/main.js",
  "description": "菲比啾比 - 鸣潮抽卡分析工具",
  "author": "feibijiubi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Untsia/FeibiJiubi.git"
  },
  "homepage": "https://github.com/Untsia/FeibiJiubi",
  "scripts": {
    "start": "electron src/main.js",
    "test": "node --test \"tests/*.test.js\"",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{js,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{js,css,html}\"",
    "obfuscate": "node scripts/obfuscate.js",
    "bytecode": "node scripts/compile-bytecode.js",
    "prebuild": "node scripts/build-pipeline.js",
    "build": "electron-builder",
    "build:insecure": "node -e \"process.env.SKIP_HARDEN='1';require('child_process').execSync('npm run build',{stdio:'inherit'})\""
  },
  "keywords": [
    "wuthering-waves",
    "鸣潮",
    "抽卡分析",
    "唤取",
    "gacha",
    "electron"
  ],
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "asarmor": "^1.8.3",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "javascript-obfuscator": "^4.2.2",
    "prettier": "^3.4.2"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "better-sqlite3": "^13.0.3",
    "bytenode": "^1.6.0",
    "dayjs": "^1.11.13",
    "iconv-lite": "^0.6.3"
  },
  "build": {
    "appId": "com.feibijiubi.app",
    "productName": "菲比啾比",
    "copyright": "Copyright © 2026",
    "releaseInfo": {
      "releaseNotesFile": "release-notes.md"
    },
    "files": [
      ".build/src/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "afterPack": "scripts/afterPack.js",
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "src/assets/icon.ico",
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ],
        "publisherName": "feibijiubi"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "artifactName": "FeibiJiubi-${version}-windows-${arch}-setup.exe"
    },
    "portable": {
      "artifactName": "FeibiJiubi-${version}-windows-${arch}-portable.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Untsia",
        "repo": "FeibiJiubi"
      }
    ]
  }
}

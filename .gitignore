# 依赖 / 构建产物
node_modules/
dist/
out/
release/
.build/

# Rust 原生加固模块（含密钥签名底座，不公开）+ 编译缓存
native/
# 保留 native 构建缓存忽略规则（防缓存文件入库）
native/**/target/

# 日志
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 用户隐私数据（本机抽卡记录数据库，禁止入库）
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# 编辑器 / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# 工作区内部数据（CodeBuddy 记忆等，非项目源码）
.codebuddy/

# 误生成的临时 / 杂项文件
-w
*.tmp

# 临时补丁 / 调试脚本（下划线前缀，非项目源码）
_*.js
_*.txt
_*.json
_*.bat
# 例外：tests/_mocks.js 是正式测试用 mock 模块（非临时脚本），必须入库，否则 npm test 无法运行
!tests/_mocks.js

# 备份文件（拆分/迁移前的残留，不入仓库）
*.bak

# 构建日志 / 打包状态文件（非源码，本地产物）
build_err*.txt
build_log*.txt
build_pid.txt
build_v130.txt
build_launcher_state.txt
build_run.log
build_verify*.log
build*.log
push*.log
push*.bat

# 发布 / 仓库杂项（本地调试用，不入仓库）
gh_releases.txt
release_edit*.txt
release_upload*.txt
release_view.txt
v130_notes.md
wake_marker.txt

# 用户隐私数据库（本机抽卡记录，禁止入库）
gacha_data.db
feibijiubi.db
